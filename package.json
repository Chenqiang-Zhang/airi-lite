{
  "name": "airi-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/index.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.local server/index.mjs",
    "test": "node --test server/*.test.mjs src/*.test.mjs shared/*.test.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@uzen/kokoro-js": "1.2.4",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "^6.5.10",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@10.33.0"
}
