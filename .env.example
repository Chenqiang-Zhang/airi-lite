# Create .env.local from this file. Never commit a real API key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional generation controls
DEEPSEEK_MAX_TOKENS=320
DEEPSEEK_TEMPERATURE=0.8
PORT=5173
HOST=127.0.0.1

# Required in production. Use a long random code to protect API spending.
AIRI_DEMO_ACCESS_CODE=

# Optional cloud TTS. An absent selection preserves MiniMax compatibility;
# unknown provider names fail closed, even if another provider has credentials.
TTS_PROVIDER=minimax

# Optional paid MiniMax TTS. Default OFF; all four activation fields are required.
# Keep credentials/voice ID server-side; do not use a VITE_ prefix.
MINIMAX_TTS_ENABLED=0
# API key: 1–4096 visible ASCII characters, no whitespace/Unicode/control characters.
MINIMAX_API_KEY=
# Voice ID: <=256 UTF-16 characters, well-formed Unicode, no control characters.
MINIMAX_VOICE_ID=
MINIMAX_TTS_DAILY_CHAR_LIMIT=
# Only speech-2.8-turbo and speech-2.8-hd are accepted.
MINIMAX_TTS_MODEL=speech-2.8-turbo
# Currently only cn is supported (fixed https://api.minimax.cn/v1/t2a_v2).
MINIMAX_TTS_REGION=cn
# Returns documented MP3 (32000 Hz, mono), decoded by the browser; no raw PCM assumptions.
# One request: <=360 UTF-16 characters, <=30 seconds, <=2 MiB encoded audio.
# The UTC-day conservative reservation ledger is .data/tts-budget.json.
# Every attempt reserves 2 * text.length; failed/cancelled calls are not refunded.
# Preserve this directory across restarts/deployments; do not share multi-instance
# deployments without a coordinated ledger. It is not MiniMax's actual balance.

# Optional ElevenLabs v4. Default OFF; selection + all four activation fields
# are required. Do not activate without account/voice/cost and license approval.
# Use TTS_PROVIDER=elevenlabs after selecting this provider explicitly.
ELEVENLABS_TTS_ENABLED=0
# API key: 1–4096 visible ASCII characters, no whitespace/Unicode/control characters.
ELEVENLABS_API_KEY=
# Voice ID: 1–256 ASCII letters/digits/underscores/hyphens.
ELEVENLABS_VOICE_ID=
# Only eleven_v4 over HTTP is supported here, NOT eleven_v4_turbo/WebSocket.
ELEVENLABS_TTS_MODEL=eleven_v4
ELEVENLABS_TTS_DAILY_CHAR_LIMIT=
# Fixed Text to Dialogue with-timestamps endpoint, Chinese, single server voice.
# MP3 44100 Hz mono/stereo; decoded samples drive mouth, not text timestamps.
# .data/tts-budget-elevenlabs.json is an independent UTC-day reservation ledger.
# Each attempt reserves the full outgoing script's UTF-16 length, including
# trusted delivery tags. This local cap is NOT ElevenLabs billing/credits/balance.
# Preserve both providers' ledgers. Failed/cancelled calls are not refunded.
