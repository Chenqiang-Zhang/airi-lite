# Create .env.local from this file. Never commit a real API key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional generation controls
DEEPSEEK_MAX_TOKENS=320
DEEPSEEK_TEMPERATURE=0.8
PORT=5173
HOST=127.0.0.1

# Required in production. Use a long random code to protect API spending.
AIRI_DEMO_ACCESS_CODE=

# Optional cloud TTS. An absent selection preserves MiniMax compatibility;
# unknown provider names fail closed, even if another provider has credentials.
TTS_PROVIDER=minimax

# Optional paid MiniMax TTS. Default OFF; all four activation fields are required.
# Keep credentials/voice ID server-side; do not use a VITE_ prefix.
MINIMAX_TTS_ENABLED=0
# API key: 1–4096 visible ASCII characters, no whitespace/Unicode/control characters.
# Use an ordinary API key issued for the selected cn/global region; keys must
# match the endpoint region. Web Audio gifts/subscriptions are not API credit.
MINIMAX_API_KEY=
# Voice ID: <=256 UTF-16 characters, well-formed Unicode, no control characters.
MINIMAX_VOICE_ID=
MINIMAX_TTS_DAILY_CHAR_LIMIT=
# Only speech-2.8-turbo and speech-2.8-hd are accepted.
MINIMAX_TTS_MODEL=speech-2.8-turbo
# cn (default): https://api.minimax.cn/v1/t2a_v2
# global: https://api.minimax.io/v1/t2a_v2
# Only these two fixed endpoints are allowed; there is no custom URL setting.
# Keep disabled until the matching regional key, quota and cost are confirmed.
MINIMAX_TTS_REGION=cn
# Returns documented MP3 (32000 Hz, mono), decoded by the browser; no raw PCM assumptions.
# One request: <=360 UTF-16 characters, <=30 seconds, <=2 MiB encoded audio.
# The UTC-day conservative reservation ledger is .data/tts-budget.json.
# Every attempt reserves 2 * text.length; failed/cancelled calls are not refunded.
# This is the same local cap in both regions, NOT a Chinese billing multiplier.
# Optional returned usage_characters is the provider's billed character count;
# word_count is reference text length only. Missing usage does not mean free.
# Preserve this directory across restarts/deployments; do not share multi-instance
# deployments without a coordinated ledger. Switching region must not reset it.
# It is not MiniMax's actual balance; no account/Audio gift quota migration is assumed.

# Optional ElevenLabs v4. Default OFF; selection + all four activation fields
# are required. Do not activate without account/voice/cost and license approval.
# Use TTS_PROVIDER=elevenlabs after selecting this provider explicitly.
ELEVENLABS_TTS_ENABLED=0
# API key: 1–4096 visible ASCII characters, no whitespace/Unicode/control characters.
ELEVENLABS_API_KEY=
# Voice ID: 1–256 ASCII letters/digits/underscores/hyphens.
ELEVENLABS_VOICE_ID=
# Only eleven_v4 over HTTP is supported here, NOT eleven_v4_turbo/WebSocket.
ELEVENLABS_TTS_MODEL=eleven_v4
ELEVENLABS_TTS_DAILY_CHAR_LIMIT=
# Fixed Text to Dialogue with-timestamps endpoint, Chinese, single server voice.
# MP3 44100 Hz mono/stereo; decoded samples drive mouth, not text timestamps.
# .data/tts-budget-elevenlabs.json is an independent UTC-day reservation ledger.
# Each attempt reserves the full outgoing script's UTF-16 length, including
# trusted delivery tags. This local cap is NOT ElevenLabs billing/credits/balance.
# Preserve both providers' ledgers. Failed/cancelled calls are not refunded.

# Optional self-hosted TTS (any OpenAI-compatible POST /v1/audio/speech, e.g.
# a CosyVoice wrapper on a GPU box). Default OFF; TTS_PROVIDER=local plus the
# URL, model and voice are required. See docs/local-tts.md.
LOCAL_TTS_ENABLED=0
# Base URL without /v1. Only http(s) to an IP literal on loopback (127/8, ::1),
# RFC1918 (10/8, 172.16/12, 192.168/16), link-local (169.254/16, fe80::/10) or
# exactly "localhost". Public hosts, other names, user:password, ?query and
# #fragment fail closed. A path prefix is allowed.
LOCAL_TTS_URL=
# 1–128 of A-Z a-z 0-9 . _ : / @ + - (whatever the engine expects).
LOCAL_TTS_MODEL=
# A speaker name the engine knows; <=256 characters, no control characters.
LOCAL_TTS_VOICE=
# wav (default; rate read from the RIFF header) or mp3 (needs SAMPLE_RATE).
LOCAL_TTS_FORMAT=wav
# Optional bearer key, if the wrapper checks one; visible ASCII, no spaces.
LOCAL_TTS_API_KEY=
# Integer 8000–96000. Required for mp3; every frame must match it.
LOCAL_TTS_SAMPLE_RATE=
# Runaway guard only (no bill): .data/tts-budget-local.json, UTC day,
# UTF-16 units of spoken text. Empty means the default 500000.
LOCAL_TTS_DAILY_CHAR_LIMIT=
# 1 sends a short Chinese "instructions" string for each non-neutral tone, and
# for a laugh or sigh act.
# Leave 0 unless the engine understands that field.
LOCAL_TTS_INSTRUCTIONS=0
# One request: <=360 UTF-16 characters, <=30 s (warm the engine up first),
# <=2 MiB audio. Engine error bodies are never shown to visitors.

# Live streaming (docs/live-runbook.md). `npm run live` sets NODE_ENV=production
# and AIRI_LIVE=1 itself; never set AIRI_LIVE on a public web deployment.
# Host profile checked by the go-live preflight: cloud (cloud TTS, e.g. this
# Mac + MiniMax) or local-voice (TTS_PROVIDER=local on this machine or LAN).
AIRI_PROFILE=cloud
# Brain calls per day, failed and aborted ones included (1–5000); the stream
# pauses when it is used up. Counted in .data/live-reply-budget.json.
LIVE_DAILY_REPLY_LIMIT=250
# Maximum output tokens per live reply (32–400).
LIVE_MAX_TOKENS=160

# Bilibili open platform (read only by scripts/bili-probe.mjs until M5).
# Keep them in .env.local only; never paste them anywhere else.
BILIBILI_OPEN_ACCESS_KEY_ID=
BILIBILI_OPEN_ACCESS_KEY_SECRET=
BILIBILI_OPEN_APP_ID=
BILIBILI_OPEN_CODE=
