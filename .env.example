# Create .env.local from this file. Never commit a real API key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional generation controls
DEEPSEEK_MAX_TOKENS=320
DEEPSEEK_TEMPERATURE=0.8
PORT=5173
HOST=127.0.0.1

# Required in production. Use a long random code to protect API spending.
AIRI_DEMO_ACCESS_CODE=
