node_modules/
dist/
.DS_Store
*.local
.env
.env.*
!.env.example
.data/
.codex-efficient-workflow/

# Live2D sample data is downloaded separately under its own license.
public/models/*
!public/models/.gitkeep

# Kokoro voice embeddings are installed separately from the source code.
public/kokoro/voices/*
!public/kokoro/voices/.gitkeep

# Claude Code local state (side-session worktrees, preview configs), at any
# depth. Only the root cloud-session startup hook and its settings are shared.
**/.claude/*
!/.claude/settings.json
!/.claude/hooks/
